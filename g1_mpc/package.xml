<?xml version="1.0"?>
<package format="2">
  <name>g1_mpc</name>
  <version>0.2.0</version>
  <description>
    Convex single-rigid-body model predictive controller, gait scheduler and
    footstep planner for the Unitree G1.
  </description>

  <maintainer email="yiannisloizu@gmail.com">Ioannis Loizou</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>g1_msgs</depend>
  <depend>eigen</depend>

  <export>
  </export>
</package>
